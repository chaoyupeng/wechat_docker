# Copy to .env and edit. Everything here has a working default.
#   cp .env.example .env

# Timezone inside the container. Affects WeChat's message timestamps.
TZ=Etc/UTC

# The container's own subnet. docker-compose.yml and harden-network.sh both
# read this, so they can never drift apart. Change it only if it collides with
# something on your network.
WECHAT_SUBNET=172.30.7.0/24

# Resource ceiling. WeChat idles around 250 MB and is comfortable at 4 GB.
WECHAT_MEM=4g
WECHAT_CPUS=4

# ---------------------------------------------------------------------------
# Optional lockdown. The browser tab is the widest remaining channel into the
# container; uncomment any of these to close part of it. See the README section
# "What is not isolated".
# ---------------------------------------------------------------------------

# Require a token to open the session. Strongly recommended if anyone else can
# reach this machine. Generate one with: openssl rand -hex 24
#SELKIES_MASTER_TOKEN=

# Kill two-way clipboard sync between your Mac and WeChat.
#SELKIES_CLIPBOARD_ENABLED=false

# Kill drag-and-drop file transfer in and out of the container.
#SELKIES_FILE_TRANSFERS=

# Stop the container from being able to ask your browser for its microphone.
#SELKIES_MICROPHONE_ENABLED=false

# Disable the session-sharing link feature.
#SELKIES_ENABLE_SHARING=false
